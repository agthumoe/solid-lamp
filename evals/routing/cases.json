{
  "schemaVersion": 1,
  "boundaryVersion": 1,
  "kind": "golden-design-fixtures",
  "notice": "Entire default accepted specialist environment is hypothetical, not installed/enabled/benchmarked project state. No runtime policy or model was executed. Apply object patches recursively; arrays and null replace rather than merge. Each case starts from a fresh defaults copy. Reasons represent the declared design oracle, not observed outputs.",
  "defaults": {
    "request": {
      "ownerAgent": "finance",
      "proposal": ["finance"],
      "authenticated": true,
      "roleOverride": null,
      "writeRequested": false,
      "outputStarted": false,
      "cancelled": false,
      "remainingMs": 30000,
      "attempts": 0,
      "plan": null
    },
    "allowedAgents": ["knowledge", "legal-us-tx", "finance", "accountant"],
    "enabledAgents": ["knowledge", "legal-us-tx", "finance", "accountant"],
    "bindings": {
      "knowledge": {
        "role": "knowledge",
        "primary": "qwen-general",
        "profile": "synthetic-accepted-profile",
        "enabled": true,
        "fallbackEnabled": true,
        "fallback": "qwen-general"
      },
      "legal-us-tx": {
        "role": "legal-research",
        "primary": "saul-legal",
        "profile": "synthetic-accepted-profile",
        "enabled": true,
        "fallbackEnabled": true,
        "fallback": "qwen-general"
      },
      "finance": {
        "role": "financial-analysis",
        "primary": "fin-r1",
        "profile": "synthetic-accepted-profile",
        "enabled": true,
        "fallbackEnabled": true,
        "fallback": "qwen-general"
      },
      "accountant": {
        "role": "accounting",
        "primary": "cpa-qwen",
        "profile": "synthetic-accepted-profile",
        "enabled": true,
        "fallbackEnabled": true,
        "fallback": "qwen-general"
      }
    },
    "models": {
      "qwen-general": {
        "state": "enabled",
        "artifactResolved": true,
        "profileAccepted": true,
        "license": "verified",
        "evidenceRevoked": false,
        "domainAccepted": true,
        "capability": "text",
        "availability": "ready"
      },
      "saul-legal": {
        "state": "enabled",
        "artifactResolved": true,
        "profileAccepted": true,
        "license": "verified",
        "evidenceRevoked": false,
        "domainAccepted": true,
        "capability": "text",
        "availability": "ready"
      },
      "fin-r1": {
        "state": "enabled",
        "artifactResolved": true,
        "profileAccepted": true,
        "license": "verified",
        "evidenceRevoked": false,
        "domainAccepted": true,
        "capability": "text",
        "availability": "ready"
      },
      "cpa-qwen": {
        "state": "enabled",
        "artifactResolved": true,
        "profileAccepted": true,
        "license": "verified",
        "evidenceRevoked": false,
        "domainAccepted": true,
        "capability": "text",
        "availability": "ready"
      }
    },
    "untrustedSourceText": null,
    "retrieval": {
      "required": false,
      "activeSpace": "qwen-space-v1",
      "querySpace": "qwen-space-v1",
      "activeDimensions": 1024,
      "queryDimensions": 1024,
      "embedAvailable": true
    }
  },
  "cases": [
    {
      "id": "R01",
      "description": "Explicit finance selection overrides legal classifier proposal",
      "inputPatch": {
        "request": {
          "proposal": ["legal-us-tx"]
        }
      },
      "expected": {
        "kind": "route",
        "reason": "PRIMARY_READY",
        "agent": "finance",
        "modelId": "fin-r1",
        "attemptLimit": 2,
        "writeAllowed": false
      },
      "coverage": ["owner-priority"]
    },
    {
      "id": "R02",
      "description": "Broad knowledge selects retained Qwen",
      "inputPatch": {
        "request": {
          "ownerAgent": "knowledge",
          "proposal": ["knowledge"]
