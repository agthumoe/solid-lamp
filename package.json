{
  "name": "aetherion-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "bench:models": "node scripts/bench/models.ts",
    "dev:inference": "node --env-file-if-exists=.env apps/inference/src/main.ts",
    "dev:api": "node --env-file-if-exists=.env apps/api/src/main.ts",
    "dev:worker": "node --env-file-if-exists=.env apps/worker/src/main.ts",
    "dev:mcp-brain": "node --env-file-if-exists=.env apps/mcp/src/brain/main.ts",
    "doctor": "node --env-file-if-exists=.env scripts/doctor/doctor.ts",
    "db:start": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "db:stop": "docker compose --env-file .env -f infra/docker-compose.yml stop",
    "db:migrate": "node --env-file-if-exists=.env scripts/db/supabase-cli.ts migrate",
    "db:status": "node --env-file-if-exists=.env scripts/db/supabase-cli.ts status",
    "db:backup": "node --env-file-if-exists=.env scripts/db/backup.ts",
    "db:restore-verify": "node --env-file-if-exists=.env scripts/db/restore-verify.ts",
    "brain:fixture-vault": "node scripts/brain/fixture-vault.ts",
    "brain:watch-latency": "node scripts/brain/watch-latency.ts",
    "brain:pdf-fixtures": "node scripts/brain/make-pdf-fixtures.ts",
    "test:bench": "node scripts/bench/integrity.test.ts",
    "test:templates": "node --test 'docs/development/templates/**/*.test.ts'",
    "test:shared": "node --test 'packages/shared/**/*.test.ts'",
    "test:llm": "node --test 'packages/llm/**/*.test.ts'",
    "test:inference": "node --test 'apps/inference/**/*.test.ts'",
    "test:brain": "node --test 'packages/brain/**/*.test.ts' 'scripts/brain/*.test.ts'",
    "test:api": "node --test 'apps/api/**/*.test.ts'",
    "test:worker": "node --test 'apps/worker/src/**/*.test.ts'",
    "test:mcp": "node --test 'apps/mcp/src/**/*.test.ts'",
    "test:doctor": "node --test scripts/doctor/doctor.test.ts",
    "test:db": "node --test 'packages/db/src/**/*.test.ts' scripts/db/supabase-cli.test.ts scripts/db/recovery-core.test.ts",
    "test:int": "node --test 'packages/db/test/integration/*.int.test.ts' 'scripts/db/*.int.test.ts' 'apps/worker/test/integration/*.int.test.ts'",
    "docs:check": "node scripts/check-docs.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/bench/integrity.test.ts && node --test scripts/lib/*.test.ts && node scripts/compliance/compliance.test.ts && node scripts/evals/integrity.test.ts && node scripts/domain-evals/integrity.test.ts && pnpm test:templates && pnpm test:shared && pnpm test:llm && pnpm test:inference && pnpm test:api && pnpm test:doctor && pnpm test:db && pnpm test:brain && pnpm test:worker && pnpm test:mcp",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compliance:check": "node scripts/check-compliance.ts",
    "deps:audit": "pnpm audit --audit-level high",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm evals:check && pnpm evals:domain:check && pnpm docs:check && pnpm compliance:check && pnpm format:check",
    "evals:check": "node scripts/evals/check.ts",
    "evals:domain:check": "node scripts/domain-evals/check.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "supabase": "2.119.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "dependencies": {
    "@aetherion/brain": "workspace:*",
    "@aetherion/db": "workspace:*",
    "@aetherion/shared": "workspace:*",
    "pino": "10.4.0",
    "yaml": "2.8.4",
    "zod": "4.6.7"
  }
}
