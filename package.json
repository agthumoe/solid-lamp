{
  "name": "aetherion-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "bench:models": "node scripts/bench/models.ts",
    "test:bench": "node scripts/bench/integrity.test.ts",
    "docs:check": "node scripts/check-docs.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/bench/integrity.test.ts && node scripts/compliance/compliance.test.ts && node scripts/evals/integrity.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compliance:check": "node scripts/check-compliance.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm evals:check && pnpm docs:check && pnpm compliance:check && pnpm format:check",
    "evals:check": "node scripts/evals/check.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "yaml": "2.8.4"
  },
  "dependencies": {
    "pino": "10.4.0",
    "zod": "4.6.7"
  }
}
