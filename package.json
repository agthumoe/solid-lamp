{
  "name": "aetherion-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "bench:models": "node scripts/bench/models.ts",
    "test:bench": "node scripts/bench/integrity.test.ts",
    "test:templates": "node --test 'docs/development/templates/**/*.test.ts'",
    "test:shared": "node --test 'packages/shared/**/*.test.ts'",
    "test:llm": "node --test 'packages/llm/**/*.test.ts'",
    "test:inference": "node --test 'apps/inference/**/*.test.ts'",
    "docs:check": "node scripts/check-docs.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/bench/integrity.test.ts && node scripts/compliance/compliance.test.ts && node scripts/evals/integrity.test.ts && node scripts/domain-evals/integrity.test.ts && pnpm test:templates && pnpm test:shared && pnpm test:llm && pnpm test:inference",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compliance:check": "node scripts/check-compliance.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm evals:check && pnpm evals:domain:check && pnpm docs:check && pnpm compliance:check && pnpm format:check",
    "evals:check": "node scripts/evals/check.ts",
    "evals:domain:check": "node scripts/domain-evals/check.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "dependencies": {
    "pino": "10.4.0",
    "yaml": "2.8.4",
    "zod": "4.6.7"
  }
}
