# Copy to .env (git-ignored). Only AETHERION_* keys are read by runtime config.
# Directory holding models.yaml and agent config (default: config)
AETHERION_CONFIG_DIR=config
# debug | info | warn | error (default: info)
AETHERION_LOG_LEVEL=info
# Optional Ollama override; must be loopback or Tailscale (default: models.yaml ollama.base_url)
AETHERION_OLLAMA_URL=
# Internal inference RPC (apps/inference). Shared secret for api/worker → inference; 32+ chars.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
AETHERION_INFERENCE_SECRET=
# Bind host (loopback or Tailscale only; default 127.0.0.1) and port (default 4100)
AETHERION_INFERENCE_HOST=127.0.0.1
AETHERION_INFERENCE_PORT=4100
# Public API (apps/api): bind host (loopback or Tailscale; default 127.0.0.1) and port (default 4000)
AETHERION_API_HOST=127.0.0.1
AETHERION_API_PORT=4000
# Key the brain CLI/MCP send as x-aetherion-service-key (32+ chars, different from the inference
# secret). Empty means brain routes refuse every request. Generate it like the inference secret.
AETHERION_BRAIN_SERVICE_KEY=
# Local Supabase Postgres from infra/docker-compose.yml (`pnpm db:start`). Pick a strong local
# password; it is set on first start of the postgres volume.
AETHERION_POSTGRES_PASSWORD=
# Same password, percent-encoded, in a private-host URL. Empty means readiness reports not_configured.
# Example: postgresql://postgres:<password>@127.0.0.1:54322/postgres
AETHERION_DATABASE_URL=
# Where api/worker reach apps/inference (default http://127.0.0.1:4100)
AETHERION_INFERENCE_URL=http://127.0.0.1:4100
# Backup/restore (pnpm run db:backup / db:restore-verify). A role that may create and drop
# databases; runtime processes never read it. Until the runtime role is narrowed (#91) it may
# use the same credentials as AETHERION_DATABASE_URL.
AETHERION_MAINTENANCE_DATABASE_URL=
# Container that runs Postgres (pg_dump/pg_restore run inside it). Default aetherion-postgres-1
AETHERION_PG_CONTAINER=aetherion-postgres-1
# Dump folder (git-ignored, private permissions) and how many dumps to keep (1-90)
AETHERION_BACKUP_DIR=backups
AETHERION_BACKUP_KEEP=7
# Owner's Obsidian vault for the `vault` source in config/sources.yaml (absolute ext4 path inside
# WSL; /mnt/c is refused). The source stays disabled until the owner approves reading it.
AETHERION_VAULT_ROOT=
# Worker (apps/worker): Redis on a private host, health bind host/port, job concurrency (1-8)
AETHERION_REDIS_URL=redis://127.0.0.1:6379
AETHERION_WORKER_HOST=127.0.0.1
AETHERION_WORKER_PORT=4400
AETHERION_WORKER_CONCURRENCY=1
