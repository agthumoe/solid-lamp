# Copy to .env (git-ignored). Only AETHERION_* keys are read by runtime config.
# Directory holding models.yaml and agent config (default: config)
AETHERION_CONFIG_DIR=config
# debug | info | warn | error (default: info)
AETHERION_LOG_LEVEL=info
# Optional Ollama override; must be loopback or Tailscale (default: models.yaml ollama.base_url)
AETHERION_OLLAMA_URL=
